<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares which languages Ortho Tips ships. Android 13+ reads this to build the
  per-app language picker in system settings; without it the app never appears
  there and the in-app toggle would be the only way to switch.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="fr" />
</locale-config>
