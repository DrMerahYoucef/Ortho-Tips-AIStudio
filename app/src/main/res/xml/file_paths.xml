<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Operative protocol PDFs: filesDir/protocols/*.pdf -->
    <files-path name="protocols" path="protocols/" />
    <!-- Patient database ZIP exports: cacheDir/exports/*.zip -->
    <cache-path name="exports" path="exports/" />
    <!-- Patient images/documents, for sharing an individual file: filesDir/patients/ -->
    <files-path name="patients" path="patients/" />
    <!-- Operative guide figures imported from the guide data: filesDir/imported_figures/ -->
    <files-path name="figures" path="imported_figures/" />
    <!-- Figures shipped as drawables, copied before sharing: cacheDir/shared_figures/ -->
    <cache-path name="shared_figures" path="shared_figures/" />
    <!-- Freshly recorded videos handed to the camera app: cacheDir/captures/ -->
    <cache-path name="captures" path="captures/" />
    <!-- Photos taken for extension file inputs (capture): cacheDir/extension_camera/ -->
    <cache-path name="extension_camera" path="extension_camera/" />
</paths>
